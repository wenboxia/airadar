# 复制为 .env 并填入真实值（.env 已在 .gitignore 中，不会入库）
# 三个角色分工见 docs/decisions.md D10；模型清单实测于 2026-08-28（查各家 /models 接口）

# 主力：干活的模型（triage 评分 / 摘要 / 分类）
AIRADAR_LLM_BASE_URL=https://api.deepseek.com
AIRADAR_LLM_API_KEY=
AIRADAR_LLM_MODEL=deepseek-v4-pro

# 备用：主力永久性故障（余额/认证/模型不存在）时自动接管，跨厂商避免单点
AIRADAR_FALLBACK_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AIRADAR_FALLBACK_API_KEY=
AIRADAR_FALLBACK_MODEL=glm-5.3

# 裁判：评测用，故意与主力不同家（避免 self-preference bias）
AIRADAR_JUDGE_BASE_URL=https://api.moonshot.cn/v1
AIRADAR_JUDGE_API_KEY=
AIRADAR_JUDGE_MODEL=kimi-k3
